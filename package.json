{
  "name": "agentdeck",
  "version": "2.0.0",
  "description": "A local, provider-pluggable dashboard for CLI coding agents (Claude Code, OpenAI Codex, and more) — one UI, switch providers live.",
  "type": "module",
  "scripts": {
    "stop": "node scripts/free-ports.ts",
    "predev": "node scripts/check-deps.ts --install && node scripts/free-ports.ts",
    "dev": "concurrently -n api,web -c green,blue \"node --watch server/index.ts\" \"vite\"",
    "init:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "preserver": "node scripts/check-deps.ts --install && node scripts/free-ports.ts 47841",
    "server": "node --watch server/index.ts",
    "preweb": "node scripts/check-deps.ts --install",
    "web": "vite",
    "prebuild": "node scripts/check-deps.ts --install",
    "build": "vite build",
    "prestart": "node scripts/check-deps.ts --install",
    "start": "node server/index.ts",
    "test": "node scripts/test.ts",
    "check:providers": "node scripts/check-providers.ts",
    "check:deps": "node scripts/check-deps.ts --verbose",
    "check:privacy": "node scripts/check-privacy.ts",
    "check:spec": "node scripts/check-spec.ts",
    "release:check": "npm run lint && npm run check:types && npm test && npm run build && npm run check:providers && npm run check:privacy && npm run check:spec",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "check:types": "node scripts/gen-types.ts --check && node scripts/check-types.ts",
    "snapshot": "node scripts/snapshot.ts",
    "check:layout": "node scripts/check-layout.ts",
    "gen:types": "node scripts/gen-types.ts",
    "test:server": "node --test \"test/server/**/*.test.ts\"",
    "test:ui": "vitest run test/ui",
    "test:integration": "node --test \"test/integration/**/*.test.ts\" && vitest run test/integration",
    "migrate:state": "node scripts/migrate-state.ts",
    "new:provider": "node scripts/new-provider.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@tanstack/react-query": "^5.102.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "highlight.js": "^11.10.0",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "trash": "^10.1.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^16.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
