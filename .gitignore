# dependencies
node_modules

# build output
dist

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local config — holds machine-specific tracked-folder paths (seeded on first run)
roots.json

# env files
.env
.env.*

# editor / OS
.DS_Store
.vscode
.idea
*.swp

# local test project used to exercise Codex (subagents, tool calls)
testproj/

# per-provider tracked roots (machine-specific absolute paths). Current home is
# .agentdeck/roots/; these legacy copies and their .migrated markers are retained
# by the startup migration so older versions keep working.
roots.claude.json
roots.codex.json
roots.antigravity.json
roots.*.json.migrated
# format-drift probe store (per provider). Current home is .agentdeck/probe/;
# legacy copies and .migrated markers are retained likewise.
probe.*.json
probe.*.json.migrated
# AI hand-off briefs (server/shared/handoff.ts), written under the config dir like probe.*.json
handoffs/
# Portable conversation exports and tiny local delivery receipts (private).
.agentdeck/
dashboards/
# .claude/ is local, all of it: settings.local.json, the maintainer's own skills,
# and a symlink for find-skills. find-skills has one canonical copy, the
# committed skills/find-skills (pinned by skills-lock.json); .claude/skills/
# points at it rather than holding a second copy, so there is nothing here to
# keep in sync. scripts/setup.sh and setup.ps1 create that link.
.claude/

# local research notes, handoffs, scratch — never committed (see CLAUDE.md)
tmp/

# maintainer working notes for Claude — local only, like .claude/ (see README for public docs)
CLAUDE.md
/AGENTS.md
