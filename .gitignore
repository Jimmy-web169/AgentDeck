# dependencies
node_modules

# build output
dist

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local config — holds machine-specific tracked-folder paths (seeded on first run)
roots.json

# env files
.env
.env.*

# editor / OS
.DS_Store
.vscode
.idea
*.swp

# local test project used to exercise Codex (subagents, tool calls)
testproj/

# per-provider tracked roots (machine-specific absolute paths)
roots.claude.json
roots.codex.json
roots.antigravity.json
# format-drift probe store (per provider), written next to roots.*.json by a server run from the repo
probe.*.json
# AI hand-off briefs (server/shared/handoff.ts), written under the config dir like probe.*.json
handoffs/
# Portable conversation exports and tiny local delivery receipts (private).
.agentdeck/
dashboards/
# .claude/ is local (settings.local.json, the maintainer's own skills) — except the
# find-skills skill (canonical copy in skills/find-skills; this one is what Claude
# Code loads) so any CLI can search the skills ecosystem during an AI hand-off;
# skills-lock.json pins it
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/find-skills/

# local research notes, handoffs, scratch — never committed (see CLAUDE.md)
tmp/

# maintainer working notes for Claude — local only, like .claude/ (see README for public docs)
CLAUDE.md
/AGENTS.md
